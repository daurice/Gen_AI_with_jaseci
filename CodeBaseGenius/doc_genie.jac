import py_module from "utils.py" as py_utils;
import from repo_mapper;
import from code_analyzer;
import from byllm.llm { Model };
import os; # Need this for path joining

glob llm = Model(model_name="gpt-4o");

# -----------------
# AGENT / WALKER
# -----------------

walker DocGenie {

    # --- Main assembly walker ---
    can assemble_documentation(
        repo: node::Repository,
        tree: node::FileTree,
        readme: node::Readme,
        ccg: node::CodeContextGraph
    ) -> str {
        log_info(here, "DocGenie: Assembling documentation...");
        
        doc = [];
        doc.append(f"# Documentation for {repo.name}");
        doc.append(f"> Generated by Codebase Genius on {std.time_now()}\n");
        
        # 1. Overview from README
        doc.append("## 1. Project Overview");
        doc.append(readme.summary);

        # 2. Installation (simple version)
        visit here walker::DocGenie.find_installation_guide(repo=repo);
        doc.append("## 2. Installation & Usage");
        doc.append(visitor.report);

        # 3. Repository Structure
        doc.append("## 3. Repository Structure");
        doc.append("```");
        doc.append(tree.structure);
        doc.append("```");
        
        # 4. Code Diagram
        doc.append("## 4. Code Architecture Diagram");
        visit here walker::DocGenie.generate_diagram_doc(
            repo = repo,
            ccg = ccg
        );
        doc.append(visitor.report); # This will be the markdown image link or error

        # 5. API Reference
        doc.append("## 5. API Reference");
        visit here walker::DocGenie.generate_api_reference(ccg=ccg);
        doc.append(visitor.report);
        
        # 6. Full README
        if readme.content != "*No README file found.*" {
            doc.append("## 6. Full README");
            doc.append("<details><summary>Click to expand</summary>\n");
            doc.append(readme.content);
            doc.append("\n</details>");
        }

        final_doc = "\n\n".join(doc);
        
        # Save the final doc
        save_result = py_utils.save_documentation(repo.name, final_doc);
        if save_result["status"] == "error" {
            log_error(here, f"Failed to save doc: {save_result['message']}");
            report {"status": "error", "message": save_result["message"]};
        } else {
            log_info(here, f"DocGenie: Documentation saved to {save_result['path']}");
            report {"status": "success", "path": save_result["path"], "content": final_doc};
        }
    }


    # --- Sub-walkers for each section ---

    can find_installation_guide(repo: node::Repository) {
        import os;
        files = os.listdir(repo.local_path);
        guide = [];
        
        if "requirements.txt" in files {
            guide.append("Found `requirements.txt`. Install dependencies with:");
            guide.append("```bash\npip install -r requirements.txt\n```");
        }
        elif "pyproject.toml" in files {
            guide.append("Found `pyproject.toml`. This project likely uses PEP 621, Poetry, or Hatch.");
            guide.append("```bash\n# For standard install\npip install .\n\n# If using Poetry\npoetry install\n```");
        }
        else {
            guide.append("No common installation files (like `requirements.txt` or `pyproject.toml`) found. Please refer to the README for installation instructions.");
        }

        # Look for entry points
        main_files = [f for f in files if f.startswith("main.py") or f.startswith("app.py")];
        if not main_files {
             # Check subdirs
            for root, dirs, files_in_root in os.walk(repo.local_path):
                if ".git" in root or "node_modules" in root:
                    continue
                for f in files_in_root:
                    if f == "main.py" or f == "app.py":
                        main_files.append(os.path.join(os.path.relpath(root, repo.local_path), f));
                if main_files:
                    break
        }
        
        if main_files {
            guide.append("\n**Potential Entry Points:**\n");
            guide.append("A possible entry point for the application was found:");
            guide.append(f"```bash\npython {main_files[0].replace(os.sep, '/')}\n```");
        }
        
        report "\n".join(guide);
    }

    can generate_diagram_doc(repo: node::Repository, ccg: node::CodeContextGraph) -> str {
        log_info(here, "DocGenie: Generating code diagram...");
        
        # 1. Prepare data for Graphviz
        graph_data = {"modules": {}, "calls": [], "inheritance": []};
        
        modules = [ccg --> (node::Module)];
        for mod in modules {
            mod_data = {"classes": [], "functions": []};
            mod_path = mod.context["path"];
            
            # Get classes and methods
            classes = [mod --> (node::Class)];
            for cls in classes {
                class_id = mod_path + "::" + cls.context["name"];
                class_info = {"id": class_id, "name": cls.context["name"], "methods": []};
                
                methods = [cls --> (node::Function)];
                for met in methods {
                    method_id = class_id + "::" + met.context["name"];
                    class_info["methods"].append({"id": method_id, "name": met.context["name"]});
                }
                mod_data["classes"].append(class_info);

                # Check for inheritance
                inherited = [cls --edge::Inherits--> (node::Class)];
                for parent in inherited {
                    # Find parent ID
                    parent_mod = [parent <--(edge::Defines)- (node::Module)];
                    if parent_mod {
                        parent_id = parent_mod[0].context["path"] + "::" + parent.context["name"];
                        graph_data["inheritance"].append({"child": class_id, "parent": parent_id});
                    }
                }
            }
            
            # Get standalone functions
            functions = [mod --> (node::Function)];
            for func in functions {
                func_id = mod_path + "::" + func.context["name"];
                mod_data["functions"].append({"id": func_id, "name": func.context["name"]});

                # Check for calls
                calls_out = [func --edge::Calls--> (node::Function)];
                for target_func in calls_out {
                    target_id = "";
                    # Find target_func ID
                    target_class = [target_func <--(edge::Contains)- (node::Class)];
                    if target_class {
                        target_mod = [target_class[0] <--(edge::Defines)- (node::Module)];
                        if target_mod {
                             target_id = target_mod[0].context["path"] + "::" + target_class[0].context["name"] + "::" + target_func.context["name"];
                        }
                    } else {
                        target_mod = [target_func <--(edge::Defines)- (node::Module)];
                         if target_mod {
                             target_id = target_mod[0].context["path"] + "::" + target_func.context["name"];
                         }
                    }
                    
                    if target_id {
                        graph_data["calls"].append({"from": func_id, "to": target_id});
                    }
                }
            }
            graph_data["modules"][mod.context["path"]] = mod_data;
        }
        
        
        # 2. Call Python utility to render diagram
        # Save diagram inside the `outputs/<repo_name>` dir
        output_dir = os.path.join("outputs", repo.name);
        img_filename = repo.name + "_architecture";
        output_path = os.path.join(output_dir, img_filename); # utils.py will add .png

        diagram_result = py_utils.generate_diagram(graph_data, output_path);
        
        if diagram_result["status"] == "success" {
            # Return markdown to embed the relative path
            # The path must be relative to the streamlit app's root
            img_path = diagram_result["path"].replace(os.sep, '/');
            log_info(here, f"DocGenie: Diagram created. Path: {img_path}");
            report f"![Architecture Diagram]({img_path})\n\n*Note: This is a simplified diagram of classes, methods, and functions.*";
        } else {
            log_warning(here, f"Could not generate diagram: {diagram_result['message']}");
            report f"*(Failed to generate code diagram: {diagram_result['message']})*";
        }
    }

    can generate_api_reference(ccg: node::CodeContextGraph) -> str {
        log_info(here, "DocGenie: Generating API Reference...");
        api_doc = [];
        modules = [ccg --> (node::Module)];

        # Sort modules for consistent output
        modules.sort(key=lambda n: n.context["path"]);
        
        for mod in modules {
            api_doc.append(f"### Module: `{mod.context['path']}`");
            
            # Document Classes
            classes = [mod --> (node::Class)];
            classes.sort(key=lambda n: n.context["name"]);
            for cls in classes {
                api_doc.append(f"\n#### `class {cls.context['name']}`");
                if cls.context["docstring"] and cls.context["docstring"] != "None" {
                    api_doc.append(f"> {cls.context['docstring'].strip()}\n");
                }
                
                methods = [cls --> (node::Function)];
                methods.sort(key=lambda n: n.context["name"]);
                for met in methods {
                    args_str = ", ".join(met.context["args"]);
                    return_str = f" -> {met.context['return_type']}" if met.context["return_type"] != "None" else "";
                    api_doc.append(f"- **`{met.context['name']}({args_str})`**`{return_str}`");
                    if met.context["docstring"] and met.context["docstring"] != "None" {
                        api_doc.append(f"  > *{met.context['docstring'].strip()}*");
                    }
                }
            }
            
            # Document Functions
            functions = [mod --> (node::Function)];
            functions.sort(key=lambda n: n.context["name"]);
            if functions {
                api_doc.append(f"\n**Functions:**\n");
                for func in functions {
                     args_str = ", ".join(func.context["args"]);
                     return_str = f" -> {func.context['return_type']}" if func.context["return_type"] != "None" else "";
                     api_doc.append(f"- **`{func.context['name']}({args_str})`**`{return_str}`");
                     if func.context["docstring"] and func.context["docstring"] != "None" {
                        api_doc.append(f"  > *{func.context['docstring'].strip()}*");
                    }
                }
            }
            api_doc.append("\n---"); # Separator
        }
        
        if not modules {
            api_doc.append("No Python/Jac source code was parsed for an API reference.");
        }
        
        report "\n".join(api_doc);
    }
}

